                      },
                      "spec": {
                        "query": "\r\nfrom(bucket: \"arduinostorage\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) =>\r\n    r._measurement == \"lidar\" and r._field != \"dist_cm\"\r\n  )\r\n  |> map(fn: (r) => ({\r\n      r with\r\n      _value:\r\n        if r._field == \"pitch\" then float(v: r._value - 144) / 2.43\r\n        else if r._field == \"yaw\" then float(v: r._value - 81) / 1.65\r\n        else float(v: r._value)\r\n  }))\r\n"
